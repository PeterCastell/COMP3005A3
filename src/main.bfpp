$import("utils.bfpp")
$import("functions.bfpp")
$import("net.bfpp")
$import("db.bfpp")

&getAllStudents (
    $run_query_4 (+"SELECT * FROM students ORDER BY student_id") () () () ()
)

# 0 = first_name, 1 = last_name, 2 = email, 3 = enrollment_date
&addStudent (
    $run_query_4
        (+"INSERT INTO students (first_name, last_name, email, enrollment_date) VALUES ('%s', '%s', '%s', '%s')")
        ($$0) ($$1) ($$2) ($$3)
)

# 0 = student_id, 1 = new_email
&updateStudentEmail (
    $run_query_4
        (+"UPDATE students SET email = '%s' WHERE student_id = '%s'")
        ($$1) ($$0) () ()
)

# 0 = student_id
&deleteStudent (
    $run_query_4 (+"DELETE FROM students WHERE student_id = '%s'") ($$0) () () ()
)



# core setup
$setup_functions
$create_func_caller

$net_startup

# 127.0.0.1:5432
$db_connect
    (+127 >3 +1 <3)
    (+21 > +56 <)
    (+"postgres")
    (+"comp3005_a3")
    (+"Password: " $print_nt $clear_nt $read_line)


$getAllStudents

$addStudent (+"Peter") (+"Castell") (+"peter@castell.org") (+"2023-09-03")

$updateStudentEmail (+"1") (+"john@example.com")

$deleteStudent (+"3")

$db_disconnect
$net_cleanup
